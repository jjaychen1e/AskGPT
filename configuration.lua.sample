    -- Use {input} as a placeholder for user input (requires allow_input = true)
    -- Set hide_highlighted_text = true to hide "Highlighted text: ..." in results
    -- Set hide_user_prompt = true to hide the first "User: ..." message in results
    custom_buttons = {
        {
            label = "Summarize",
            model = "gpt-4o-mini",  -- Optional: override default model
